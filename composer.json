{
    "name": "membershipext/membershipext",
    "type": "typo3-cms-extension",
    "description": "membershipext desc",
    "authors": [],
    "license": "GPL-2.0-or-later",
    "require": {
        "typo3/cms-core": "^12.4"
    },
    "autoload": {
        "psr-4": {
            "membershipext\\Membershipext\\": "Classes"
        }
    },
    "replace": {
        "typo3-ter/membershipext": "self.version"
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin"
    },
    "scripts": {
        "post-autoload-dump": [
            "TYPO3\\TestingFramework\\Composer\\ExtensionTestEnvironment::prepare"
        ]
    },
    "extra": {
        "typo3/cms": {
            "web-dir": ".Build/public",
            "extension-key": "membershipext"
        }
    }
}